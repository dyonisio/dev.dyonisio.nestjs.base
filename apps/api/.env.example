# ---------- App ----------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent  (JSON em produção, legível em development)
LOG_LEVEL=info
APP_NAME="NestJS Base API"
# URL pública da API (usada nos e-mails)
APP_URL=http://localhost:3000
# URL do frontend (links de redefinição de senha apontam para cá)
FRONTEND_URL=http://localhost:5173
# Origens (front) que podem chamar a API pelo navegador, separadas por vírgula.
# Em desenvolvimento pode ser *; em produção é obrigatório listar os domínios.
CORS_ORIGIN=*
# Idioma das mensagens de erro quando o cliente não envia Accept-Language
# (ou pede um idioma não suportado). Suportados: en, pt-BR
FALLBACK_LANGUAGE=en

# ---------- Swagger ----------
# Documentação em /docs. Padrão: habilitado fora de produção (em produção, só se pedir)
SWAGGER_ENABLED=true

# ---------- Banco de dados ----------
# postgres | sqljs (sqljs = banco em memória, usado nos testes e2e)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_base
DB_SSL=false
# Com DB_SSL=true o certificado do banco é conferido. Para o RDS fora da Lambda (ECS/Docker),
# baixe a CA da AWS para certs/ e aponte aqui (veja certs/README.md)
DB_SSL_CA_FILE=
DB_SSL_REJECT_UNAUTHORIZED=true
# NUNCA use synchronize=true em produção; use migrations
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Em Lambda mantenha o pool pequeno (1-2) — cada container abre suas conexões
DB_POOL_MAX=10

# ---------- Auth ----------
# Segredo dos tokens. Em produção: >= 32 caracteres e NUNCA este valor de exemplo (a API recusa).
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Validade do access token (JWT) em segundos — curta, renovada via /auth/refresh (900 = 15 min)
JWT_EXPIRES_IN=900
# Validade do refresh token em segundos (2592000 = 30 dias)
REFRESH_TOKEN_EXPIRES_IN=2592000
# Validade do link de redefinição de senha em segundos (900 = 15 min)
RESET_PASSWORD_EXPIRES_IN=900
# Validade do convite para criar a senha, quando um admin cria a conta sem senha (604800 = 7 dias)
INVITE_EXPIRES_IN=604800
# Validade do link mágico de login (entrar sem digitar a senha), em segundos (900 = 15 min)
MAGIC_LINK_EXPIRES_IN=900
# Ícone da conta no app autenticador (2FA), em HTTPS. Vazio = FRONTEND_URL/icon.png quando o site é HTTPS.
# Só alguns apps mostram (FreeOTP, 2FAS, Aegis); Google/Microsoft Authenticator mostram só o nome (APP_NAME).
# TOTP_IMAGE_URL=
# Exige e-mail confirmado nas rotas autenticadas (exceto as marcadas com @AllowUnverified)
REQUIRE_EMAIL_VERIFICATION=true
# Validade do link de confirmação de e-mail em segundos (86400 = 24 h)
EMAIL_VERIFICATION_EXPIRES_IN=86400
# Idade máxima de uma sessão em dias, mesmo usada todo dia (depois, login de novo)
SESSION_MAX_AGE_DAYS=90
# Custo do hash de senha (bcrypt). 12 é o recomendado; cada +1 dobra o tempo
BCRYPT_ROUNDS=12
# Contas sem senha (só login social) confirmam ações sensíveis entrando de novo:
# o login precisa ter sido há no máximo este tempo (segundos)
REAUTH_WINDOW_SECONDS=600

# ---------- Rate limiting (contadores na tabela rate_limits) ----------
RATE_LIMIT_ENABLED=true
# Geral: qualquer rota, por IP (janela em segundos)
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_GLOBAL_TTL=60
# Rotas sensíveis (login, cadastro, senha, verificação): janela em segundos (900 = 15 min)
RATE_LIMIT_AUTH_TTL=900
RATE_LIMIT_AUTH_IP_LIMIT=20
RATE_LIMIT_AUTH_EMAIL_LIMIT=5
# Nº de proxies/load balancers confiáveis na frente da API (para descobrir o IP real).
#  - AWS Lambda: 0 (o API Gateway já entrega o IP de origem)
#  - ECS/containers atrás de um ALB: 1
# Errar para MAIS permite forjar o IP (X-Forwarded-For); para MENOS, todos dividem o mesmo limite.
# Em produção fora da Lambda é obrigatório definir.
TRUST_PROXY=0

# Chave para cifrar dados sensíveis no banco (segredos de 2FA). Obrigatória em produção (>= 32 chars).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NÃO troque depois de em uso: segredos cifrados com a chave antiga deixam de abrir.
ENCRYPTION_KEY=

# ---------- Login social (vazio = desligado) ----------
# Client IDs do SEU app no provedor, separados por vírgula (web, iOS, Android...)
GOOGLE_CLIENT_IDS=
# Apple: Services ID (web) e/ou Bundle ID (iOS)
APPLE_CLIENT_IDS=

# ---------- Arquivos (upload) ----------
# local = disco (dev/testes) | s3 = Amazon S3 (obrigatório em produção)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=tmp/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
# Base das URLs públicas (ex.: https://cdn.seudominio.com com CloudFront). Vazio = URL do bucket
STORAGE_PUBLIC_URL=
# Validade (s) das URLs de upload e de download de arquivos privados
STORAGE_UPLOAD_EXPIRES_IN=600
STORAGE_DOWNLOAD_EXPIRES_IN=300
# Limpeza automática: uploads pending ou nunca usados são apagados após este tempo (horas)
FILES_CLEANUP_AFTER_HOURS=24
FILES_CLEANUP_BATCH_SIZE=500
# Máximo de uploads não concluídos por usuário (evita abuso de armazenamento)
FILES_MAX_PENDING_PER_USER=20
# Envios por pessoa em 24 h e espaço total por pessoa em bytes (0 = sem limite). 104857600 = 100 MB
FILES_MAX_UPLOADS_PER_DAY=50
FILES_MAX_BYTES_PER_USER=104857600

# ---------- Manutenção (Lambda maintenance / npm run maintenance) ----------
# Sessões encerradas/expiradas ficam este tempo (histórico e alerta de dispositivo novo)
SESSIONS_RETENTION_DAYS=30
# Trilha de auditoria: registros mais antigos são apagados (0 = guardar para sempre)
AUDIT_RETENTION_DAYS=365
# Conta excluída: depois deste prazo os dados pessoais são apagados de vez (LGPD)
ACCOUNT_PURGE_AFTER_DAYS=30

# ---------- Seed (npm run seed) ----------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
# Vazio = o seed gera uma senha forte e mostra uma única vez no terminal
ADMIN_PASSWORD=

# ---------- E-mail ----------
# smtp | ses | json (json = não envia, apenas loga — útil em dev/test)
MAIL_TRANSPORT=smtp
MAIL_FROM="NestJS Base <no-reply@example.com>"
MAIL_SUPPORT_EMAIL=suporte@example.com
# Fuso horário das datas exibidas nos e-mails
MAIL_TIMEZONE=America/Sao_Paulo
# sync = envia durante a requisição (dev) | sqs = publica na fila e a Lambda mailWorker envia
MAIL_DELIVERY=sync
# URL da fila SQS (obrigatória com MAIL_DELIVERY=sqs; na Lambda o serverless.yml preenche)
MAIL_QUEUE_URL=

# SMTP (o docker-compose sobe o Mailpit: UI em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SES (usado quando MAIL_TRANSPORT=ses). Na Lambda o padrão é AWS_REGION.
SES_REGION=us-east-1
