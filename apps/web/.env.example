# Endereço da API (sem barra no final). Em produção o deploy preenche com https://api.<seu-domínio>
VITE_API_URL=http://localhost:3000

# Login social (opcional): vazio = botão escondido. Use os MESMOS client IDs da API
# (GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS), senão ela recusa o token. Veja docs/WEB.md → Login social.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
