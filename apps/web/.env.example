# Endereço da API (sem barra no final). Em produção o deploy preenche com https://api.<seu-domínio>
VITE_API_URL=http://localhost:3000

# Nome do produto (barra lateral, login, título da aba). No deploy vem da variável APP_NAME do GitHub.
VITE_APP_NAME=NestJS Base

# Páginas de Privacidade e Termos (/privacy, /terms): responsável pelos dados e e-mail de contato.
# No deploy vêm das variáveis LEGAL_OWNER e SUPPORT_EMAIL do GitHub.
VITE_LEGAL_OWNER=
VITE_SUPPORT_EMAIL=support@example.com

# Login social (opcional): vazio = botão escondido. Use os MESMOS client IDs da API
# (GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS), senão ela recusa o token. Veja docs/WEB.md → Login social.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
