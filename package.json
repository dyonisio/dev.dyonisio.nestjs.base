{
  "name": "nestjs-base-api",
  "version": "1.0.0",
  "description": "Base de API em NestJS com TypeORM, roles, auth, users, e-mails com templates, Swagger, testes e deploy em AWS Lambda",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --config jest.coverage.js --coverage --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:pg": "jest --config ./test/jest-postgres.json --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "seed": "ts-node src/database/seeds/run-seed.ts",
    "maintenance": "ts-node src/maintenance/run-maintenance.ts",
    "maintenance:prod": "node dist/maintenance/run-maintenance.js",
    "mail:preview": "ts-node scripts/mail-preview.ts",
    "lambda:invoke": "ts-node scripts/invoke-lambda-local.ts",
    "openapi:export": "ts-node scripts/export-openapi.ts",
    "offline": "npm run build && serverless offline",
    "deploy": "npm run build && serverless deploy",
    "deploy:prod": "npm run build && serverless deploy --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.1151.0",
    "@aws-sdk/s3-presigned-post": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@codegenie/serverless-express": "^4.16.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.3",
    "@electric-sql/pglite-socket": "^0.0.8",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "serverless": "^3.39.0",
    "serverless-offline": "^13.9.0",
    "sql.js": "^1.12.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.4.3"
    }
  }
}
